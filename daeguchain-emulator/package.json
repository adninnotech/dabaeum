{
  "name": "daeguchain-emulator",
  "version": "0.1.0",
  "private": true,
  "description": "다배움 대구체인 에뮬레이터. 백엔드와 REST로 통신하고 내부에서 Fabric 체인코드를 호출한다.",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@hyperledger/fabric-gateway": "~1.11.0",
    "@hyperledger/fabric-protos": "^0.3.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.29.0",
    "pino": "^9.6.0",
    "ssh2": "^1.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
