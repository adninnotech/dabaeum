# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소에 넣지 않는다.
# 값 이름은 백엔드 application.yml 의 dabaeum.fabric.* 와 1:1 로 맞췄다.

# ---- 모듈 HTTP ----
MODULE_HOST=127.0.0.1
MODULE_PORT=8090
# /fabric/* 통과 경로 전용. 비워두면 검사하지 않는다.
MODULE_API_KEY=
LOG_LEVEL=info

# ---- 대구체인 에뮬레이터 신원 ----
# 요청 본문 token 과 비교한다. 비워두면 검사하지 않는다. 실제 대구체인은 App Key 로 발급한 Token 을 받는다.
EMULATOR_TOKEN=
# 요청 본문 chain 값. 문서 기본값 dchain
EMULATOR_CHAIN=dchain
# owner 주소와 서명자 공개키를 파생하는 시드. 바꾸면 주소가 바뀐다.
EMULATOR_OWNER_SEED=dabaeum-daeguchain-emulator
# Storage 프로젝트 목록(projects.json)을 두는 디렉터리
EMULATOR_DATA_DIR=./data

# ---- Fabric 쓰기 승인 ----
# false 면 submit 계열이 전부 FABRIC_WRITE_NOT_APPROVED(403) 으로 막힌다. 조회는 된다.
FABRIC_WRITE_ENABLED=false

# ---- SSH 터널 (peer 와 다른 장비에서 구동할 때만) ----
# peer 와 같은 호스트에서 구동하면 false 로 둔다.
# 개발 PC 에서 붙일 때만 true 로 바꾸고 SSH 계정을 채운다.
FABRIC_TUNNEL_ENABLED=false
FABRIC_SSH_HOST=
FABRIC_SSH_PORT=22
FABRIC_SSH_USERNAME=
FABRIC_SSH_PASSWORD=
# known_hosts 로 호스트 키를 검증한다. 비워두면 ~/.ssh/known_hosts 를 쓴다.
FABRIC_SSH_KNOWN_HOSTS=
FABRIC_LOCAL_PORT=7051
FABRIC_REMOTE_HOST=127.0.0.1
FABRIC_REMOTE_PORT=7051

# ---- Fabric Gateway ----
FABRIC_OVERRIDE_AUTHORITY=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=continualtion-edu
# Fabric 인증 자료. 저장소에 넣지 않고 auth/ 아래에 배치한다.
FABRIC_CERTIFICATE_PATH=./auth/User1@org1.example.com-cert.pem
FABRIC_PRIVATE_KEY_PATH=./auth/priv_sk
FABRIC_TLS_CA_PATH=./auth/ca.crt
# 밀리초
FABRIC_EVALUATE_TIMEOUT_MS=5000
FABRIC_ENDORSE_TIMEOUT_MS=15000
FABRIC_SUBMIT_TIMEOUT_MS=5000
FABRIC_COMMIT_TIMEOUT_MS=60000
