# dev 서버 비밀값 서식. 실제 파일은 서버의 /home/adn/dabaeum/dev-secrets.env (권한 600) 이고
# 저장소에 올리지 않는다. 값은 담당자 비밀번호 관리자(원본)에서 가져와 채운다.
#
# 구동 스크립트(~/dabaeum/script/run-dabaeum-daeguchain.sh)가 openbao.env 다음에 읽는다:
#   set -a; . "$HOME_DIR/dev-secrets.env"; set +a
# 파일이 없으면 스크립트의 파일 점검에서 멈춘다. 값이 비면 앱 기동이 실패한다(기본값 없음).
#
# 여기에는 비밀만 둔다. 비밀이 아닌 설정(원장 주소·프로젝트 ID·기능 플래그·키 파일 경로)은
# 구동 스크립트의 export 에, OpenBao AppRole 자격은 openbao.env 에 있다.
# 형식은 bash 다: 이름=값. 값에 $ ! 공백 같은 특수문자가 있으면 작은따옴표로 감싼다.

# dev DB
DABAEUM_DB_USERNAME=
DABAEUM_DB_PASSWORD=

# 로그인 JWT (HS256). 서버에서 생성한다: openssl rand -base64 32. local 키와 다른 값이어야 한다.
DABAEUM_JWT_SIGNING_KEY=
# kid. local-* 로 시작하면 dev 기동이 거부된다. 키를 교체하면 dev-2, dev-3 으로 올린다.
DABAEUM_JWT_KEY_ID=

# 대구체인 BaaS Storage 토큰. 콘솔(SETTING > KEY)에서 마지막으로 만든 토큰만 유효하므로
# 콘솔에서 재발급하면 이 값도 함께 바꾼다. 주소·프로젝트 ID 는 구동 스크립트의 export 에 있다.
DABAEUM_DAEGUCHAIN_TOKEN=

# 공공데이터포털 서비스키(일반 인증키 Decoding). 전국평생학습강좌표준데이터 수집에 쓴다.
# 자동 수집 스위치(DABAEUM_PUBLIC_COURSES_ENABLED)는 비밀이 아니므로 구동 스크립트 export 에 둔다.
DABAEUM_PUBLIC_DATA_SERVICE_KEY=

# 다대구 QR 로그인·출석
DABAEUM_DADAEGU_SITE_ID=
DABAEUM_DADAEGU_PRIVATE_KEY=
