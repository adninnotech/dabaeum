# local 프로필 비밀값 서식. 이 파일을 local-secrets.env 로 복사해 값을 채운다 (local-secrets.env 는 커밋되지 않는다).
#   cp local-secrets.env.example local-secrets.env && chmod 600 local-secrets.env
# 값은 담당자 비밀번호 관리자(원본)에서 받는다. 메신저·문서에 붙이지 않는다.
# 형식은 Java properties 다: 이름=값, 따옴표 없이. 값에 \ 가 있으면 \\ 로 쓴다.
# 주의: 통합 테스트 스크립트는 이 파일을 bash 식으로 읽어 \\ 를 그대로 둔다. 값에 \ 가 있으면
#       통합 테스트용 환경 파일(scripts/integration-test.env.example)을 따로 만든다.

# dev 서버 SSH 터널 (application-local.yml 의 ssh-tunnel)
DABAEUM_SSH_USERNAME=
DABAEUM_SSH_PASSWORD=

# dev DB (터널을 거쳐 127.0.0.1:15432/dabaeum_dev)
DABAEUM_DB_USERNAME=
DABAEUM_DB_PASSWORD=

# local 전용 JWT 서명키. 각자 만든다: openssl rand -base64 32
DABAEUM_JWT_SIGNING_KEY=

# 다대구 QR 로그인
DABAEUM_DADAEGU_SITE_ID=
DABAEUM_DADAEGU_PRIVATE_KEY=
