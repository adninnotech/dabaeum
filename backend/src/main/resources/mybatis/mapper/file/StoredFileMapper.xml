<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.adn.dabaeum.file.infrastructure.mybatis.StoredFileMapper">

    <resultMap
        id="storedFileRowResultMap"
        type="com.adn.dabaeum.file.infrastructure.mybatis.StoredFileRow">

        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="purpose" javaType="java.lang.String"/>
            <arg column="original_name" javaType="java.lang.String"/>
            <arg column="content_type" javaType="java.lang.String"/>
            <arg column="size" javaType="java.lang.Long"/>
            <arg column="storage_path" javaType="java.lang.String"/>
            <arg column="uploaded_by" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO tb_files (
            id, purpose, original_name, content_type, size, storage_path,
            uploaded_by, created_at
        ) VALUES (
            #{id}, #{purpose}, #{originalName}, #{contentType}, #{size},
            #{storagePath}, #{uploadedBy}, #{createdAt}
        )
    </insert>

    <select id="selectById" resultMap="storedFileRowResultMap">
        SELECT id, purpose, original_name, content_type, size, storage_path,
               uploaded_by, created_at
        FROM tb_files
        WHERE id = #{id}
    </select>

</mapper>
