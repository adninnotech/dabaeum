<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.adn.dabaeum.credential.infrastructure.mybatis.CredentialStatusListMapper">

    <resultMap id="credentialStatusListRowResultMap"
        type="com.adn.dabaeum.credential.infrastructure.mybatis.CredentialStatusListRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="institution_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="list_no" javaType="java.lang.Integer"/>
            <arg column="status_purpose" javaType="java.lang.String"/>
            <arg column="capacity" javaType="java.lang.Integer"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="credentialStatusListEntryRowResultMap"
        type="com.adn.dabaeum.credential.infrastructure.mybatis.CredentialStatusListEntryRow">
        <constructor>
            <arg column="status_list_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="status_list_index" javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <sql id="credentialStatusListColumns">
        id, institution_id, list_no, status_purpose, capacity, created_at
    </sql>

    <insert id="insert">
        INSERT INTO tb_credential_status_lists (
            id, institution_id, list_no, status_purpose, capacity, created_at
        ) VALUES (
            #{id}, #{institutionId}, #{listNo}, #{statusPurpose}, #{capacity}, #{createdAt}
        )
    </insert>

    <select id="selectById" resultMap="credentialStatusListRowResultMap">
        SELECT <include refid="credentialStatusListColumns"/>
          FROM tb_credential_status_lists
         WHERE id = #{listId}
    </select>

    <select id="selectLatestByInstitutionId" resultMap="credentialStatusListRowResultMap">
        SELECT <include refid="credentialStatusListColumns"/>
          FROM tb_credential_status_lists
         WHERE institution_id = #{institutionId}
         ORDER BY list_no DESC
         LIMIT 1
    </select>

    <select id="countEntries" resultType="long">
        SELECT COUNT(*)
          FROM tb_credentials
         WHERE status_list_id = #{listId}
    </select>

    <!--
        자리가 없는 행에만, 그리고 비어 있는 칸에만 배정한다.
        NOT EXISTS 로 미리 걸러 0건 갱신으로 끝내는 것이 핵심이다. 제약 위반으로 실패하게 두면
        PostgreSQL 이 트랜잭션 전체를 중단시켜(25P02) 호출자가 다른 칸으로 재시도할 수 없다.
        경쟁 트랜잭션이 동시에 같은 칸을 통과하는 경우만 uq_tb_credentials_status_list_entry 가
        막고, 그때는 발급 자체가 실패하고 워커가 다시 시도한다.
    -->
    <update id="assignEntry">
        UPDATE tb_credentials
           SET status_list_id = #{listId},
               status_list_index = #{index}
         WHERE id = #{credentialId}
           AND status_list_id IS NULL
           AND NOT EXISTS (
               SELECT 1
                 FROM tb_credentials taken
                WHERE taken.status_list_id = #{listId}
                  AND taken.status_list_index = #{index}
           )
    </update>

    <select id="selectEntryByCredentialId" resultMap="credentialStatusListEntryRowResultMap">
        SELECT status_list_id, status_list_index
          FROM tb_credentials
         WHERE id = #{credentialId}
    </select>

    <select id="selectRevokedIndexes" resultType="java.lang.Integer">
        SELECT status_list_index
          FROM tb_credentials
         WHERE status_list_id = #{listId}
           AND status IN ('REVOKED', 'SUPERSEDED')
         ORDER BY status_list_index
    </select>
</mapper>
