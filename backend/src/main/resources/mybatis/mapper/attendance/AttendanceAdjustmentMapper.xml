<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.adn.dabaeum.attendance.infrastructure.mybatis.AttendanceAdjustmentMapper">

    <resultMap id="attendanceAdjustmentRowResultMap"
               type="com.adn.dabaeum.attendance.infrastructure.mybatis.AttendanceAdjustmentRow">
        <constructor>
            <idArg column="id" javaType="java.util.UUID"
                   typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="attendance_record_id" javaType="java.util.UUID"
                 typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="before_status" javaType="java.lang.String"/>
            <arg column="after_status" javaType="java.lang.String"/>
            <arg column="reason" javaType="java.lang.String"/>
            <arg column="adjusted_by" javaType="java.util.UUID"
                 typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="adjusted_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="attendanceAdjustmentColumns">
        id, attendance_record_id, before_status, after_status, reason,
        adjusted_by, adjusted_at, created_at
    </sql>

    <insert id="insert">
        INSERT INTO tb_attendance_adjustments (
            id, attendance_record_id, before_status, after_status, reason,
            adjusted_by, adjusted_at, created_at
        ) VALUES (
            #{id}, #{attendanceRecordId}, #{beforeStatus}, #{afterStatus}, #{reason},
            #{adjustedBy}, #{adjustedAt}, #{createdAt}
        )
    </insert>

    <select id="selectByAttendanceId" resultMap="attendanceAdjustmentRowResultMap">
        SELECT <include refid="attendanceAdjustmentColumns"/>
          FROM tb_attendance_adjustments
         WHERE attendance_record_id = #{attendanceId}
         ORDER BY adjusted_at ASC, id ASC
    </select>
</mapper>
