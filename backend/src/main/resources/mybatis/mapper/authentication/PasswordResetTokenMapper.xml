<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.adn.dabaeum.authentication.infrastructure.mybatis.PasswordResetTokenMapper">

    <resultMap
        id="passwordResetTokenRowResultMap"
        type="com.adn.dabaeum.authentication.infrastructure.mybatis.PasswordResetTokenRow">

        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="user_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="token_hash" javaType="java.lang.String"/>
            <arg column="expires_at" javaType="java.time.Instant"/>
            <arg column="used_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO tb_password_reset_tokens (
            id, user_id, token_hash, expires_at, used_at, created_at
        ) VALUES (
            #{id}, #{userId}, #{tokenHash}, #{expiresAt},
            #{usedAt, jdbcType=TIMESTAMP_WITH_TIMEZONE},
            #{createdAt}
        )
    </insert>

    <select id="selectByTokenHash" resultMap="passwordResetTokenRowResultMap">
        SELECT id, user_id, token_hash, expires_at, used_at, created_at
        FROM tb_password_reset_tokens
        WHERE token_hash = #{tokenHash}
    </select>

    <update id="markUsed">
        UPDATE tb_password_reset_tokens
           SET used_at = #{usedAt}
         WHERE id = #{id}
           AND used_at IS NULL
    </update>

</mapper>
