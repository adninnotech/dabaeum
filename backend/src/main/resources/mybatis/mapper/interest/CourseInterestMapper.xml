<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.adn.dabaeum.interest.infrastructure.mybatis.CourseInterestMapper">

    <resultMap
        id="courseInterestRowResultMap"
        type="com.adn.dabaeum.interest.infrastructure.mybatis.CourseInterestRow">

        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="user_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="course_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap
        id="courseInterestViewRowResultMap"
        type="com.adn.dabaeum.interest.infrastructure.mybatis.CourseInterestViewRow">

        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="course_id" javaType="java.util.UUID"
                typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="course_title" javaType="java.lang.String"/>
            <arg column="institution_name" javaType="java.lang.String"/>
            <arg column="category" javaType="java.lang.String"/>
            <arg column="education_type" javaType="java.lang.String"/>
            <arg column="course_status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO tb_course_interests (
            id, user_id, course_id, created_at
        ) VALUES (
            #{id}, #{userId}, #{courseId}, #{createdAt}
        )
    </insert>

    <select id="selectById" resultMap="courseInterestRowResultMap">
        SELECT id, user_id, course_id, created_at
        FROM tb_course_interests
        WHERE id = #{id}
    </select>

    <select id="selectByUserIdAndCourseId" resultMap="courseInterestRowResultMap">
        SELECT id, user_id, course_id, created_at
        FROM tb_course_interests
        WHERE user_id = #{userId}
          AND course_id = #{courseId}
    </select>

    <select id="selectByUserId" resultMap="courseInterestViewRowResultMap">
        SELECT i.id, i.course_id, i.created_at,
               c.title AS course_title, ins.name AS institution_name,
               c.category, c.education_type, c.status AS course_status
          FROM tb_course_interests i
          JOIN tb_courses c ON c.id = i.course_id
          JOIN tb_institutions ins ON ins.id = c.institution_id
         WHERE i.user_id = #{userId}
        ORDER BY i.created_at DESC, i.id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*)
        FROM tb_course_interests
        WHERE user_id = #{userId}
    </select>

    <delete id="deleteById">
        DELETE FROM tb_course_interests
        WHERE id = #{id}
    </delete>

</mapper>
